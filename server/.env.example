PORT=4000
# Leave empty for a local demo: a random secret is generated once in server/data/jwt-secret.
# Required (32+ random characters) when NODE_ENV=production or PUBLIC_APP_URL is a public address,
# otherwise the server refuses to start. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
CLIENT_ORIGIN=http://localhost:5173
PUBLIC_APP_URL=http://localhost:5173
